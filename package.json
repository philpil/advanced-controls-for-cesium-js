{
  "name": "advanced-controls-for-cesium-js",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal CesiumJS globe and interactive geometry editor",
  "scripts": {
    "start": "python3 -m http.server 8080 --directory dist",
    "test": "node --test tests/*.test.js",
    "check": "node --check dist/app.js && node --check dist/geometry.js",
    "format": "prettier --write \"dist/**/*.{js,html,css}\" \"tests/**/*.js\" package.json .prettierrc.json README.md",
    "format:check": "prettier --check \"dist/**/*.{js,html,css}\" \"tests/**/*.js\" package.json .prettierrc.json README.md"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
